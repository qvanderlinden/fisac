# Database. The app reads DATABASE_URL directly (backend/src/fisac/config.py).
DATABASE_URL=postgresql+asyncpg://fisac:changeme-fisac-password@localhost:5432/fisac

# Consumed by scripts/init-postgres.sh when provisioning Postgres: the
# password it assigns to the fisac role. Must match DATABASE_URL's.
FISAC_DB_PASSWORD=changeme-fisac-password

# OpenRouter (LLM-assisted flow generation). Get a key at
# https://openrouter.ai/keys. Model is optional - defaults to a free-tier slug
# in the app config; override if that slug gets rotated out.
OPENROUTER_API_KEY=changeme-openrouter-key
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
# Comma-separated provider slugs to restrict OpenRouter routing to (some
# providers mangle the JSON output). The generator UI shows which provider
# served each response. Empty/unset = free routing.
# OPENROUTER_PROVIDERS=deepseek
